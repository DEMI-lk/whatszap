{
  "name": "whatszap",
  "productName": "WhatsZAP",
  "desktopName": "whatszap.desktop",
  "version": "1.2.5",
  "description": "Lightweight Electron desktop client for WhatsApp Web with multiple isolated persistent profiles.",
  "license": "MIT",
  "author": "WhatsZAP contributors",
  "main": "dist/main/main.js",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc && node scripts/copy-assets.cjs && node scripts/gen-icon.cjs",
    "start": "npm run build && node scripts/launch.cjs",
    "dev": "npm run build && node scripts/launch.cjs",
    "watch": "tsc --watch",
    "dist": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb",
    "dist:linux:dir": "npm run build && electron-builder --linux dir",
    "install:linux": "npm run build && electron-builder --linux dir && node scripts/install-linux.cjs"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.5.4"
  },
  "build": {
    "appId": "com.whatszap.app",
    "productName": "WhatsZAP",
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "generic",
      "url": "https://github.com/DEMI-lk/whatszap/releases/latest/download"
    },
    "files": [
      "dist/**/*",
      "assets/icon.png",
      "assets/avatars/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "icon": "assets/icon.png",
      "syncDesktopName": true,
      "maintainer": "WhatsZAP contributors <whatszap@users.noreply.github.com>",
      "synopsis": "Lightweight WhatsApp Web desktop client with isolated profiles",
      "description": "Unofficial Electron client for WhatsApp Web with up to 10 isolated, persistent profiles.",
      "desktop": {
        "entry": {
          "Name": "WhatsZAP",
          "Comment": "WhatsApp Web desktop client with isolated profiles",
          "Categories": "Network;InstantMessaging;"
        }
      }
    },
    "deb": {
      "afterInstall": "scripts/deb-after-install.sh"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
