{
  "name": "whatszap",
  "productName": "WhatsZAP",
  "version": "1.2.1",
  "description": "Lightweight Electron desktop client for WhatsApp Web with multiple isolated persistent profiles.",
  "license": "MIT",
  "author": "WhatsZAP contributors",
  "main": "dist/main/main.js",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc && node scripts/copy-assets.cjs && node scripts/gen-icon.cjs",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron .",
    "watch": "tsc --watch",
    "dist": "npm run build && electron-builder --win"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.5.4"
  },
  "build": {
    "appId": "com.whatszap.app",
    "productName": "WhatsZAP",
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "generic",
      "url": "https://updates.invalid/whatszap"
    },
    "files": [
      "dist/**/*",
      "assets/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
